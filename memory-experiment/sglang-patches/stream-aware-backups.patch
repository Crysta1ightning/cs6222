diff --git a/python/sglang/srt/mem_cache/stream_activity.py b/python/sglang/srt/mem_cache/stream_activity.py
new file mode 100644
index 0000000000..30a95bef04
--- /dev/null
+++ b/python/sglang/srt/mem_cache/stream_activity.py
@@ -0,0 +1,282 @@
+"""Experimental single-scheduler tool-activity gate; no bandwidth estimation.
+
+The UNIX listener runs in the *scheduler* process. Its thread changes only
+lease state under a lock; cache decisions and CUDA submissions stay on the
+scheduler thread. Deferred transfers use the existing write queue and locks.
+"""
+
+import json
+import math
+import os
+import socket
+import subprocess
+import threading
+import time
+from collections import Counter, OrderedDict, deque
+from pathlib import Path
+
+MAX_FRAME = 1024 * 1024
+
+
+class ActivityController:
+    def __init__(self, mode, *, max_tokens=4096, max_ops=256, max_age=2.0,
+                 lease=15.0, max_tools=128, log_path=None, clock=time.monotonic,
+                 queue_policy="all", base_policy="write_through"):
+        if mode not in ("normal", "defer", "skip"):
+            raise ValueError("controller mode must be normal, defer, or skip")
+        if queue_policy not in ("all", "victim", "through_victim"):
+            raise ValueError("queue_policy must be all, victim or through_victim")
+        if mode != "defer" and queue_policy != "all":
+            raise ValueError("queue selection applies only to defer")
+        if base_policy not in ("write_through", "write_through_selective", "write_back"):
+            raise ValueError("unsupported base write policy")
+        self.queue_policy, self.base_policy = queue_policy, base_policy
+        if min(max_tokens, max_ops, max_tools) < 1 or not all(
+            math.isfinite(v) and v > 0 for v in (max_age, lease)
+        ):
+            raise ValueError("controller bounds must be positive and finite")
+        self.mode, self.max_tokens, self.max_ops = mode, max_tokens, max_ops
+        self.max_age, self.lease, self.max_tools = max_age, lease, max_tools
+        self.clock = clock
+        self.lock = threading.RLock()
+        self.active = {}
+        self.ended = OrderedDict()
+        self.counters = Counter(dict.fromkeys((
+            "submitted_batches", "submitted_bytes", "completed_batches", "completed_bytes",
+            "skipped_opportunities", "skipped_tokens", "deferred_decisions", "pressure_overrides",
+            "peak_pending_tokens", "peak_pending_bytes", "TOOL_END", "TOOL_EXPIRED",
+        ), 0))
+        self.events = deque(maxlen=4096)
+        self.sequence = 0
+        self.pending_tokens = self.pending_bytes = self.pending_ops = 0
+        self.pending_since = None
+        self.log_path = str(log_path) if log_path else None
+        self.log = open(log_path, "a", buffering=1) if log_path else None
+        try:
+            numa = subprocess.run(["numactl", "--show"], capture_output=True, text=True, timeout=2)
+            self.placement = dict(cpu_affinity=sorted(os.sched_getaffinity(0)), numa=numa.stdout,
+                                  numa_error=numa.stderr, numa_returncode=numa.returncode)
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            self.placement = dict(cpu_affinity=sorted(os.sched_getaffinity(0)), numa_error=str(exc))
+        self.listener = None
+        self.stop = threading.Event()
+        self.emit("CONTROLLER_START", mode=mode, pid=os.getpid(),
+                  hostname=socket.gethostname(), job_id=os.getenv("SLURM_JOB_ID"),
+                  queue_policy=queue_policy, base_policy=base_policy)
+
+    def emit(self, event, **fields):
+        with self.lock:
+            self.sequence += 1
+            item = dict(sequence=self.sequence, event=event,
+                        monotonic_ns=time.monotonic_ns(), unix_ns=time.time_ns(), **fields)
+            self.events.append(item)
+            if self.log:
+                self.log.write(json.dumps(item) + "\n")
+            return item
+
+    def _end(self, tool_id, reason):
+        self.active.pop(tool_id, None)
+        self.ended[tool_id] = None
+        while len(self.ended) > 1024:
+            self.ended.popitem(last=False)
+        self.counters[reason] += 1
+        self.emit(reason, tool_id=tool_id, active_tools=len(self.active))
+
+    def _expire(self):
+        now = self.clock()
+        for tool_id, deadline in list(self.active.items()):
+            if deadline <= now:
+                self._end(tool_id, "TOOL_EXPIRED")
+
+    def handle(self, request):
+        with self.lock:
+            if not isinstance(request, dict):
+                raise ValueError("control request must be a JSON object")
+            request_id = request.get("request_id")
+            if request_id is not None and (not isinstance(request_id, str) or len(request_id) > 128):
+                raise ValueError("invalid request_id")
+            self._expire()
+            event = request.get("event")
+            tool_id = request.get("tool_id")
+            if event in ("TOOL_START", "TOOL_END", "TOOL_HEARTBEAT"):
+                if not isinstance(tool_id, str) or not 1 <= len(tool_id) <= 128:
+                    raise ValueError("tool_id must be a nonempty string of at most 128 characters")
+            if event == "TOOL_START":
+                if tool_id in self.ended:
+                    raise ValueError("tool ID has ended/expired; use a new ID")
+                if tool_id not in self.active:
+                    if len(self.active) >= self.max_tools:
+                        raise ValueError("active tool limit reached")
+                    self.active[tool_id] = self.clock() + self.lease
+                    self.emit(event, tool_id=tool_id, request_id=request.get("request_id"),
+                              client_monotonic_ns=request.get("client_monotonic_ns"),
+                              warmup=bool(request.get("warmup")), active_tools=len(self.active))
+            elif event == "TOOL_HEARTBEAT":
+                if tool_id not in self.active:
+                    raise ValueError("tool lease not active")
+                self.active[tool_id] = self.clock() + self.lease
+            elif event == "TOOL_END":
+                if tool_id in self.active:
+                    self._end(tool_id, "TOOL_END")
+            elif event != "STATUS":
+                raise ValueError("unknown tool-activity event")
+            snapshot = self.snapshot(request.get("since", self.sequence))
+            snapshot.update(ok=True, request_id=request.get("request_id"),
+                            ack_monotonic_ns=time.monotonic_ns())
+            return snapshot
+
+    def snapshot(self, since=None):
+        with self.lock:
+            self._expire()
+            since = self.sequence if since is None else int(since)
+            events = [item for item in self.events if item["sequence"] > since][:256]
+            oldest = self.events[0]["sequence"] if self.events else self.sequence + 1
+            return dict(mode=self.mode, pid=os.getpid(), signal="tool_activity",
+                        queue_policy=self.queue_policy, base_policy=self.base_policy,
+                        scheduler_placement=self.placement,
+                        sequence=self.sequence, events=events,
+                        events_truncated=since < oldest - 1,
+                        active_tool_ids=sorted(self.active), lease_seconds=self.lease,
+                        max_pending_tokens=self.max_tokens, max_pending_ops=self.max_ops,
+                        reserve_tokens=getattr(self, "reserve_tokens", None),
+                        max_defer_seconds=self.max_age,
+                        pending_tokens=self.pending_tokens, pending_bytes=self.pending_bytes,
+                        pending_ops=self.pending_ops, counters=dict(self.counters),
+                        in_flight_batches=self.counters["submitted_batches"] - self.counters["completed_batches"],
+                        log_path=self.log_path)
+
+    def allow_optional(self, tokens):
+        with self.lock:
+            self._expire()
+            if self.active and self.mode == "skip":
+                self.counters["skipped_opportunities"] += 1
+                self.counters["skipped_tokens"] += tokens
+                self.emit("BACKUP_SKIPPED", tokens=tokens)
+                return False
+            return True
+
+    def observe_pending(self, tokens, num_bytes, ops):
+        with self.lock:
+            changed = (tokens, num_bytes, ops) != (self.pending_tokens, self.pending_bytes, self.pending_ops)
+            if tokens and self.pending_since is None:
+                self.pending_since = self.clock()
+            if not ops:
+                self.pending_since = None
+            self.pending_tokens, self.pending_bytes, self.pending_ops = tokens, num_bytes, ops
+            self.counters["peak_pending_tokens"] = max(self.counters["peak_pending_tokens"], tokens)
+            self.counters["peak_pending_bytes"] = max(self.counters["peak_pending_bytes"], num_bytes)
+            if changed:
+                self.emit("BACKUP_PENDING", tokens=tokens, bytes=num_bytes, ops=ops)
+
+    def flush_reason(self, *, free_tokens, reserve_tokens, force=None):
+        with self.lock:
+            self._expire()
+            if not self.pending_ops:
+                return None
+            if force:
+                reason = force
+            elif self.mode != "defer" or not self.active:
+                return "normal"
+            elif self.pending_tokens >= self.max_tokens or self.pending_ops >= self.max_ops:
+                reason = "pending_limit"
+            elif free_tokens < reserve_tokens:
+                if self.queue_policy != "all" and self.clock() - self.pending_since < self.max_age:
+                    # The cache selects an eligible pending victim without
+                    # borrowing live-request pins. Count an override only if
+                    # its selected batch is actually submitted.
+                    return "select_victim"
+                reason = "gpu_pressure"
+            elif self.clock() - self.pending_since >= self.max_age:
+                reason = "maximum_age"
+            else:
+                self.counters["deferred_decisions"] += 1
+                # Log the decision once per queue, not on every idle scheduler tick.
+                if not self.events or self.events[-1]["event"] != "BACKUP_DEFERRED":
+                    self.emit("BACKUP_DEFERRED", tokens=self.pending_tokens, bytes=self.pending_bytes)
+                return None
+            if self.active:
+                self.counters["pressure_overrides"] += 1
+                self.emit("BACKUP_OVERRIDE", reason=reason, tokens=self.pending_tokens,
+                          bytes=self.pending_bytes)
+            return reason
+
+    def required_override(self, reason, tokens, num_bytes):
+        with self.lock:
+            self._expire()
+            if self.active:
+                self.counters["pressure_overrides"] += 1
+                self.emit("BACKUP_OVERRIDE", reason=reason, tokens=tokens, bytes=num_bytes)
+
+    def submitted(self, num_bytes, tokens, reason, clear_pending=True):
+        with self.lock:
+            self.counters["submitted_batches"] += 1
+            self.counters["submitted_bytes"] += num_bytes
+            self.emit("BACKUP_SUBMITTED", bytes=num_bytes, tokens=tokens, reason=reason)
+            if clear_pending:
+                self.observe_pending(0, 0, 0)
+
+    def completed(self, ack):
+        with self.lock:
+            self.counters["completed_batches"] += 1
+            self.counters["completed_bytes"] += ack.num_bytes
+            duration = (ack.start_event.elapsed_time(ack.finish_event)
+                        if getattr(ack, "timing_enabled", False) else None)
+            self.emit("BACKUP_COMPLETED", bytes=ack.num_bytes, tokens=ack.num_tokens,
+                      cuda_copy_ms=duration)
+
+    def serve(self, path):
+        path = Path(path)
+        if path.exists():
+            raise ValueError(f"control socket already exists: {path}; do not overwrite a live server")
+        self.socket_path = path
+        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            listener.bind(str(path))
+        except BaseException:
+            listener.close()
+            raise
+        os.chmod(path, 0o600)
+        self.socket_inode = path.stat().st_ino
+        listener.listen(8)
+        listener.settimeout(0.2)
+        self.listener = listener
+        self.thread = threading.Thread(target=self._listen, daemon=True)
+        self.thread.start()
+
+    def _listen(self):
+        while not self.stop.is_set():
+            try:
+                connection, _ = self.listener.accept()
+            except socket.timeout:
+                with self.lock:
+                    self._expire()
+                continue
+            except OSError:
+                break
+            with connection:
+                connection.settimeout(0.5)
+                try:
+                    with connection.makefile("rb") as reader:
+                        frame = reader.readline(MAX_FRAME + 1)
+                    if len(frame) > MAX_FRAME or not frame.endswith(b"\n"):
+                        raise ValueError("invalid/oversized control frame")
+                    response = self.handle(json.loads(frame))
+                except (ValueError, TypeError, OSError) as exc:
+                    response = dict(ok=False, error=str(exc))
+                try:
+                    connection.sendall(json.dumps(response).encode() + b"\n")
+                except OSError:
+                    pass  # An unacknowledged start expires unless its client renews.
+
+    def close(self):
+        self.stop.set()
+        if self.listener:
+            self.listener.close()
+            self.thread.join(timeout=1)
+            if self.socket_path.exists() and self.socket_path.stat().st_ino == self.socket_inode:
+                self.socket_path.unlink()
+            self.listener = None
+        with self.lock:
+            if self.log:
+                self.log.close()
+                self.log = None
