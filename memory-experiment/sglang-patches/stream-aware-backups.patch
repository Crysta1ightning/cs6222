+    def _flush_activity_victim(self, reason: str = "allocation_critical") -> bool:
+        """Read-only victim planning; copy dependencies before releasing pins.
+
+        Called after the ordinary eviction heap exhausts reclaimable leaves,
+        or when pending pins prevent admission under GPU-space pressure.
+        Active-request pins are never subtracted from the live tree.
+        Queue extraction preserves the original host reservations, receipts and
+        acknowledgement IDs, including nodes split since they were queued.
+        """
+        activity = self.stream_activity
